{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Stores user digital identity and resonance profile data.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The user's neural alias." },
        "email": { "type": "string", "format": "email", "description": "The user's registered email address." },
        "bio": { "type": "string", "description": "A brief biographical resonance statement." }
      },
      "required": ["name", "email"]
    },
    "SavedPost": {
      "title": "Saved Post Idea",
      "description": "A generated post idea saved for future synchronization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner." },
        "platform": { "type": "string", "description": "The targeted social platform." },
        "topic": { "type": "string", "description": "The core topic of the post." },
        "copy": { "type": "string", "description": "The AI-generated high-fidelity copy." },
        "visuals": { "type": "string", "description": "Aesthetic direction for visuals." },
        "suggestedTime": { "type": "string", "description": "Optimal transmission window." },
        "savedAt": { "type": "string", "format": "date-time", "description": "Timestamp of capture." }
      },
      "required": ["userId", "platform", "topic", "copy", "visuals", "savedAt"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Individual user resonance profiles."
    },
    "/saved_posts/{postId}": {
      "schema": "SavedPost",
      "description": "Store of synthesized social post ideas."
    }
  }
}
